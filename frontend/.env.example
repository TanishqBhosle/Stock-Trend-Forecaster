# Stock Trend Forecaster — Environment Configuration
# Copy this file to .env and fill in real values when a backend is available.

# Base URL for the API server (leave empty to use mock data)
VITE_API_BASE_URL=

# Set to "true" to use deterministic mock data instead of the real API.
# When VITE_API_BASE_URL is empty this is automatically treated as true.
VITE_USE_MOCKS=true

# Application display name
VITE_APP_NAME=Stock Trend Forecaster

# Demo mode label shown throughout the UI
VITE_DEMO_LABEL="Demo data — not financial advice"
