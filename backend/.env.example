# Stock Trend Forecaster Backend Environment Variables
PROJECT_NAME="Stock Trend Forecaster API"
VERSION="1.0.0"
TICKER="^GSPC"
START_DATE="2000-01-01"
LOOKBACK_WINDOW=60
HIDDEN_SIZE=128
NUM_LAYERS=2
DROPOUT=0.2
LEARNING_RATE=0.001
BATCH_SIZE=64
MAX_EPOCHS=100
PATIENCE=15
BULLISH_THRESHOLD=0.005
BEARISH_THRESHOLD=-0.005
DATABASE_URL="sqlite:///./data/forecaster.db"
